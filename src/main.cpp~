#include "Capture.hpp"
#include <iostream>

int main() {
	const int width  = 640;
	const int height = 480;

	std::cout << "Creating Capture(" << width << ", " << height << ")...\n";
	Capture cam(width, height);

	// Test 1: connection check
	if (!cam.ConnectWebcam()) {
		std::cout << "[Test 1] No webcam detected/connected. "
		          << "(Expected in a headless/sandboxed environment.)\n";
		std::cout << "Class compiled and linked correctly; "
		          << "exiting gracefully instead of reading frames.\n";
		return 0;
	}
	std::cout << "[Test 1] Webcam connected successfully.\n";

	// Test 2: pull a handful of frames and validate them
	const int numFrames = 5;
	int goodFrames = 0;
	for (int i = 0; i < numFrames; ++i) {
		cv::Mat frame = cam.GetFrame();
		if (frame.empty()) {
			std::cout << "[Test 2] Frame " << i << " was empty (dropped).\n";
			continue;
		}
		++goodFrames;
		std::cout << "[Test 2] Frame " << i << ": "
		          << frame.cols << "x" << frame.rows
		          << ", channels=" << frame.channels() << "\n";
	}

	std::cout << "[Test 2] Captured " << goodFrames << "/" << numFrames
	          << " valid frames.\n";

	return 0;
}